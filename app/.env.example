# Polymind Environment Variables
# ================================
# Copy this file to .env and fill in your values

# Google Gemini API Key for AI image generation
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay (client-side publishable key — safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXX

# Firebase Cloud Functions base URL
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-YOUR-PROJECT.cloudfunctions.net
